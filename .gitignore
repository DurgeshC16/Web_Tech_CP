# Runtime-generated content — keep directories via .gitkeep, ignore the files they hold
public/qrcodes/*
!public/qrcodes/.gitkeep
public/checkpoints/latest.json
public/checkpoints/latest.*.tmp
private_data/uploads/*
!private_data/uploads/.gitkeep
private_data/php_errors.log
private_data/external_source/*
private_data/cache/external/*
private_data/tlog/*
!private_data/tlog/.gitkeep
private_data/external_credentials/*
private_data/mail/*
!private_data/mail/.gitkeep
.rnd
src/config/config.local.php
private_data/dev_mail.log
